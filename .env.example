# Copy this file to `.env` and fill in your key. Never commit `.env`.
GROQ_API_KEY=your_groq_api_key_here

# Optional tuning (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.1
# MAX_HEAL_RETRIES=3

# Vercel deployment configuration (for frontend deployments)
VERCEL_API_TOKEN=your_vercel_api_token_here
# VERCEL_TEAM_ID=your_team_id_here  # Optional: for team deployments

# Render deployment configuration (for backend deployments)
RENDER_API_KEY=your_render_api_key_here
