# Copy this file to `.env` and fill in your keys. Never commit `.env`.
GROQ_API_KEY=your_groq_api_key_here

# Optional tuning (defaults shown)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TEMPERATURE=0.1
# MAX_HEAL_RETRIES=3

# ---- DevOps / Infra -------------------------------------------------------
# Set to true to skip docker build+deploy (generate-only mode).
# SKIP_DOCKER_BUILD=false

# DOCKER_BUILD_TIMEOUT_S=180
# DOCKER_HEALTH_TIMEOUT_S=45
# DEFAULT_APP_PORT=8000

# Render (primary free host) — required for live deploy URL
# RENDER_API_KEY=
# RENDER_OWNER_ID=
# RENDER_REGION=oregon
# RENDER_PLAN=free

# Docker Hub — push local image so Render can pull it
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=

# Supabase — jobs / deployment history / logs (run supabase/schema.sql first)
# SUPABASE_URL=https://xxxx.supabase.co
# Secret key (sb_secret_... or legacy service_role) — NOT the publishable/anon key
# SUPABASE_SERVICE_KEY=

# Vite/React SPA build-args (baked into frontend images at docker build time)
# VITE_API_BASE_URL=https://your-public-api.onrender.com
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
# VITE_USE_MOCK=false
