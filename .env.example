# Copy this file to `.env` and fill in your key. Never commit `.env`.
GROQ_API_KEY=your_groq_api_key_here

# Optional tuning (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.1
# MAX_HEAL_RETRIES=3

# Supabase configuration for authentication and database
SUPABASE_URL=https://ioxdvfqvpexdkoidgjrl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GitHub token for committing Dockerfiles to repos (fallback if OAuth fails)
# Get a Personal Access Token from: https://github.com/settings/tokens
# Requires 'repo' scope for write access
GITHUB_TOKEN=your_github_pat_here

# OAuth callback URLs (update with your actual domain)
VERCEL_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/vercel/callback
RENDER_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/render/callback
RAILWAY_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/railway/callback

# OAuth app credentials (create these in Vercel/Render/Railway developer portals)
VERCEL_CLIENT_ID=your_vercel_client_id
VERCEL_CLIENT_SECRET=your_vercel_client_secret
RENDER_CLIENT_ID=your_render_client_id
RENDER_CLIENT_SECRET=your_render_client_secret
RAILWAY_CLIENT_ID=your_railway_client_id
RAILWAY_CLIENT_SECRET=your_railway_client_secret

# Account-level API tokens (fallback for deployments)
VERCEL_API_TOKEN=your_vercel_api_token
RENDER_API_TOKEN=your_render_api_token
RENDER_OWNER_ID=your_render_owner_id
VERCEL_TEAM_ID=your_vercel_team_id